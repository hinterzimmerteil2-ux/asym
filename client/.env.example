# En desarrollo local, ambas apuntan al mismo server en :3001, con
# protocolos distintos (ws:// para el socket, http:// para las llamadas
# de login normales):
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# En producción (Vercel), configurá estas env vars con la URL de tu
# servicio en Render. Render expone TLS automáticamente en ambos protocolos:
# NEXT_PUBLIC_WS_URL=wss://tu-servicio.onrender.com
# NEXT_PUBLIC_SERVER_URL=https://tu-servicio.onrender.com
